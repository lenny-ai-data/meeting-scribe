# Copier en .env puis compléter.

# --- Diarisation -------------------------------------------------------------------
# Inutile avec l'image publiée, qui embarque le modèle pyannote. Obligatoire seulement si
# l'image a été construite sans ce modèle : jeton Hugging Face en lecture, après avoir accepté
# les conditions de https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# --- Transcription ------------------------------------------------------------------
# large-v3 | large-v3-turbo
DEFAULT_MODEL=large-v3
# fr | en
DEFAULT_LANGUAGE=fr
# cuda | cpu
DEFAULT_DEVICE=cuda
BATCH_SIZE=16
# VRAM libre minimale (Go) avant de charger Whisper ; en dessous, le job échoue avec un message clair.
# Vide = selon le modèle (10 Go pour large-v3, 6 Go pour large-v3-turbo)
MIN_FREE_VRAM_GB=

# --- LLM local (Ollama sur l'hôte) -------------------------------------------------
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.8:27b
# Contexte maximal demandé à Ollama (tokens) ; le contexte réel est ajusté à la taille du transcript
OLLAMA_MAX_CTX=65536

# --- LLM distant, compatible OpenAI (OpenAI, Mistral, OpenRouter…) — optionnel -------
# ex. https://api.openai.com/v1
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_API_MODEL=

# --- Accès et intégrations -----------------------------------------------------------
# Jeton exigé sur /api/* (Authorization: Bearer …) ; vide = pas d'authentification (LAN)
API_TOKEN=
# Envoyé dans l'en-tête X-Scribe-Token des callbacks (webhooks n8n)
CALLBACK_TOKEN=
# Adresse publique du service, pour des liens absolus dans les callbacks, ex. http://mon-serveur:8090
PUBLIC_BASE_URL=

# --- Divers -----------------------------------------------------------------------
# Nom proposé dans l'interface pour nommer un intervenant (vous-même) ; vide = aucune suggestion
OWNER_NAME=
YTDLP_AUTO_UPDATE=true
TZ=Europe/Paris
