# Copier en .env puis compléter.

# --- Diarisation -------------------------------------------------------------------
# Inutile avec l'image publiée, qui embarque le modèle pyannote. Obligatoire seulement si
# l'image a été construite sans ce modèle : jeton Hugging Face en lecture, après avoir accepté
# les conditions de https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# --- Transcription ------------------------------------------------------------------
# Calcul par défaut selon l'image : cuda (image cuda) ou cpu (image cpu). Décommenter pour forcer.
# DEFAULT_DEVICE=cuda
# Profil de performance par défaut : tres_rapide | rapide | precis | tres_precis
# (vide = rapide sur CPU, tres_precis sur GPU ; détail dans le README)
# DEFAULT_PROFILE=
# fr | en
DEFAULT_LANGUAGE=fr
# Passages de 30 s transcrits par lot ; par défaut selon la VRAM libre sur GPU (16, 8 ou 4), 4 sur CPU
# BATCH_SIZE=16
# VRAM libre minimale (Go) avant de charger Whisper ; en dessous, le job échoue avec un message clair.
# Vide = selon le profil (5 Go pour large-v3, 3 Go pour large-v3-turbo, 2,6 Go pour small)
MIN_FREE_VRAM_GB=

# --- LLM : valeurs initiales, modifiables ensuite dans Réglages › Modèles de langage --
# Ollama sur ce PC (host.docker.internal) ou sur une autre machine (http://192.168.1.20:11434)
OLLAMA_URL=http://host.docker.internal:11434
# Vide = premier modèle installé
OLLAMA_MODEL=
# Contexte maximal demandé à Ollama (tokens) ; le contexte réel est ajusté à la taille du transcript
OLLAMA_MAX_CTX=65536
# Décharger Ollama avant une transcription GPU : true | false ; vide = seulement s'il tourne sur cette machine
OLLAMA_UNLOAD_BEFORE_GPU=

# API compatible OpenAI — optionnelle : OpenAI, Mistral, OpenRouter, ou LM Studio / llama.cpp
# ex. https://api.mistral.ai/v1, http://host.docker.internal:1234/v1
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_API_MODEL=

# --- Accès et intégrations -----------------------------------------------------------
# Jeton exigé sur /api/* (Authorization: Bearer …) ; vide = pas d'authentification (LAN)
API_TOKEN=
# Envoyé dans l'en-tête X-Scribe-Token des callbacks (webhooks n8n)
CALLBACK_TOKEN=
# Adresse publique du service, pour des liens absolus dans les callbacks, ex. http://mon-serveur:8090
PUBLIC_BASE_URL=

# --- Divers -----------------------------------------------------------------------
# Nom proposé dans l'interface pour nommer un intervenant (vous-même) ; vide = aucune suggestion
OWNER_NAME=
YTDLP_AUTO_UPDATE=true
TZ=Europe/Paris
